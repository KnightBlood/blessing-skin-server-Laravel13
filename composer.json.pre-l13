{
  "name": "bs-community/blessing-skin-server",
  "description": "A web application brings your custom skins back in offline Minecraft servers.",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-ctype": "*",
    "ext-gd": "*",
    "ext-imagick": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-tokenizer": "*",
    "ext-xml": "*",
    "ext-zip": "*",
    "blessing/filter": "^1.0",
    "blessing/rejection": "^1.0",
    "blessing/texture-renderer": "^0.2",
    "composer/ca-bundle": "^1.2",
    "composer/semver": "^3.2",
    "doctrine/inflector": "^2.0",
    "spatie/laravel-ignition": "^2.0",
    "gregwar/captcha": "1.*",
    "guzzlehttp/guzzle": "^7.0",
    "hoa/compiler": "^3.17",
    "intervention/image": "^2.7",
    "laravel/framework": "^12.0",
    "laravel/passport": "^13.0",
    "nesbot/carbon": "^3.8.4",
    "nunomaduro/collision": "^8.1",
    "rcrowe/twigbridge": "^0.14",
    "sanmai/hoa-protocol": "^1.17",
    "spatie/laravel-translation-loader": "^2.7",
    "symfony/process": "^6.0|^7.0",
    "symfony/yaml": "^5.0|^6.0|^7.0",
    "twig/twig": "^3.0",
    "vectorface/whip": "^0.5.0"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^3.16",
    "barryvdh/laravel-ide-helper": "^3.0",
    "fakerphp/faker": "^1.23",
    "friendsofphp/php-cs-fixer": "^3.13",
    "laravel/browser-kit-testing": "^7.2.8",
    "laravel/tinker": "^2.9|^3.0",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^11.0",
    "symfony/css-selector": "^6.2|^7.0",
    "symfony/dom-crawler": "^6.2|^7.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.5.0"
    },
    "policy": {
      "advisories": {
        "block": false
      }
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/socialite"
      ]
    }
  },
  "repositories": {
    "blessing-filter": {
      "type": "path",
      "url": "packages/blessing-filter",
      "options": {
        "symlink": false
      }
    },
    "blessing-rejection": {
      "type": "path",
      "url": "packages/blessing-rejection",
      "options": {
        "symlink": false
      }
    },
    "packagist": {
      "type": "composer",
      "url": "https://packagist.org/"
    }
  }
}
